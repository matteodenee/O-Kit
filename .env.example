# Identifiant local non sensible. La valeur par defaut est "admin".
KEYCLOAK_ADMIN_USERNAME=admin

# Remplacer cette valeur dans .env. Ne jamais versionner le mot de passe reel.
KEYCLOAK_ADMIN_PASSWORD=change-me-local-only

# Base PostgreSQL locale du service utilisateur. Ces valeurs restent
# surchargeables pour cibler l'instance physique mutualisée.
USER_DB_HOST=postgres
USER_DB_PORT=5432
USER_DB_NAME=okit_users
USER_DB_USERNAME=okit_user
USER_DB_PASSWORD=change-me-local-only

# SMTP Keycloak. Ces valeurs locales dirigent les courriels vers Mailpit.
# Pour un fournisseur externe, activer l'authentification et fournir les
# identifiants uniquement dans .env ou dans un Secret Kubernetes.
KEYCLOAK_SMTP_HOST=mailpit
KEYCLOAK_SMTP_PORT=1025
KEYCLOAK_SMTP_FROM=noreply@okit.local
KEYCLOAK_SMTP_FROM_DISPLAY_NAME="O'kit"
KEYCLOAK_SMTP_AUTH=false
KEYCLOAK_SMTP_STARTTLS=false
KEYCLOAK_SMTP_SSL=false
KEYCLOAK_SMTP_USER=
KEYCLOAK_SMTP_PASSWORD=
